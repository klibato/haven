{
  "name": "haven",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source Discord alternative — no facial scan, self-hostable",
  "license": "AGPL-3.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "clean": "turbo clean",
    "db:generate": "pnpm --filter @haven/server exec prisma generate",
    "db:push": "pnpm --filter @haven/server exec prisma db push",
    "db:seed": "pnpm --filter @haven/server exec tsx prisma/seed.ts",
    "setup": "cp -n .env.example apps/server/.env 2>/dev/null; pnpm install && pnpm db:push && pnpm db:seed"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
